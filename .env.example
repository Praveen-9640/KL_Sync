# ---- Copy to server/.env (cp .env.example server/.env) and fill in ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (create the database in pgAdmin 4 first, e.g. "hostelhub")
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/hostelhub

# Long random strings, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
OTP_SECRET=

# Current semester label used for room allocation
CURRENT_SEMESTER=Spring 2027

# ---- Email OTP (any SMTP provider: Gmail app password, Brevo, SendGrid SMTP, Mailgun...) ----
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="HostelHub <no-reply@example.com>"

# ---- SMS OTP: SMS_PROVIDER = twilio | msg91 ----
SMS_PROVIDER=
SMS_API_KEY=          # twilio: Auth Token | msg91: Auth Key
SMS_SENDER_ID=        # twilio: From number or Messaging Service SID | msg91: unused
SMS_ACCOUNT_SID=      # twilio only: Account SID
SMS_TEMPLATE_ID=      # msg91 only: OTP template id
DEFAULT_COUNTRY_CODE=+91

# ---- Development-only helper (ignored when NODE_ENV=production) ----
# When true AND a provider is NOT configured, the OTP is printed to the SERVER console only.
# It is never returned by the API. Do not treat this as real delivery.
DEV_OTP_CONSOLE=false

# ---- Admin seed (used by: npm run db:seed) ----
ADMIN_EMAIL=
ADMIN_NAME=Hostel Admin
ADMIN_STUDENT_ID=ADMIN001
